NODE_ENV=production

# Auth and security
JWT_SECRET=replace-with-strong-random-secret
USE_FIREBASE_PHONE_AUTH=true
CORS_ORIGINS=https://marketplace-store-fef91.web.app
RATE_LIMIT_PER_MIN=120
AUTH_RATE_LIMIT_PER_MIN=5
OTP_RATE_LIMIT_PER_MIN=3
SEARCH_RATE_LIMIT_PER_MIN=60
MESSAGES_RATE_LIMIT_PER_MIN=20
PRODUCT_CREATE_RATE_LIMIT_PER_MIN=10
UPLOAD_RATE_LIMIT_PER_MIN=5
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_ENFORCE=false
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_MS=604800000
MAX_CLOCK_DRIFT_MS=300000
NONCE_TTL_MS=600000
ENFORCE_REPLAY_HEADERS=true
ENABLE_SECURITY_AUDIT_LOGS=true

# Firebase public runtime config (served by backend endpoint)
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=marketplace-store-fef91.firebaseapp.com
FIREBASE_PROJECT_ID=marketplace-store-fef91
FIREBASE_STORAGE_BUCKET=marketplace-store-fef91.appspot.com
FIREBASE_MESSAGING_SENDER_ID=360203367218
FIREBASE_APP_ID=

# OAuth
GOOGLE_CLIENT_ID=

# Email OTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional SMS fallback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Optional AI provider
PERPLEXITY_API_KEY=
PERPLEXITY_AGENT_PRESET=pro-search
# PERPLEXITY_AGENT_MODEL=

# Optional analytics
GA4_MEASUREMENT_ID=
