{
  "name": "marketplace-store-functions",
  "description": "Marketplace Premium Cloud Functions",
  "type": "module",
  "main": "index.cjs",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run serve",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "migrate": "node --loader ts-node/esm scripts/migrate-data.js",
    "test:security": "node --test tests/**/*.test.mjs"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^6.3.0",
    "argon2": "^0.41.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^1.38.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.0.1",
    "firebase-admin": "^12.3.1",
    "firebase-functions": "^7.2.5",
    "google-auth-library": "^9.0.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^6.10.0",
    "pdfkit": "^0.14.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "firebase-tools": "^13.7.0"
  }
}
